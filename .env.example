# Runtime
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# JSON body limit. Multipart image uploads are capped separately at 8 MB.
BODY_LIMIT=1mb
# Public storefront origin used in password-reset and checkout return links.
STOREFRONT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://afribasket:afribasket@localhost:5432/afribasket?schema=public

# Redis (carts, rate limits, webhook idempotency, blog view buffer, BullMQ)
REDIS_URL=redis://localhost:6379

# JWT access tokens. Use long random strings in any shared environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
# Pepper for hashed rotating refresh tokens. Not a JWT signing key.
REFRESH_TOKEN_PEPPER=replace-with-another-long-random-string
REFRESH_TOKEN_TTL_DAYS=30

# OpenAPI UI at /docs. Leave DOCS_PASSWORD empty to serve 404 instead of docs.
DOCS_USER=docs
DOCS_PASSWORD=

# Account lockout and auth rate limits
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Checkout stock hold
RESERVATION_MINUTES=15

# Cloudinary (product, banner, and blog images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend transactional email. If RESEND_API_KEY is empty, emails are logged and not sent.
RESEND_API_KEY=
EMAIL_FROM=AfriBasket <orders@example.com>
ADMIN_ALERT_EMAIL=ops@example.com

# Stripe Checkout (card, Apple Pay, Google Pay, Link) and optional Stripe Tax
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
# Flat estimated tax in basis points, used only when STRIPE_TAX_ENABLED=false. 0 = no tax.
TAX_FLAT_RATE_BPS=0

# PayPal Orders API v2. Venmo is offered on the PayPal order, not as a separate provider.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Where Stripe and PayPal send the shopper after payment.
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:5173/checkout/cancel

# Shipping defaults. Seeded into site settings; admins can edit the stored row later.
FREE_SHIPPING_THRESHOLD_CENTS=7500
COLD_PACK_SURCHARGE_CENTS=800
# Weight rates are base cents plus per-extra-pound cents. Overnight is disabled for AK/HI and territories (leave blank).
SHIP_CONTIGUOUS_STANDARD_BASE_CENTS=699
SHIP_CONTIGUOUS_STANDARD_PER_LB_CENTS=50
SHIP_CONTIGUOUS_EXPEDITED_BASE_CENTS=1499
SHIP_CONTIGUOUS_EXPEDITED_PER_LB_CENTS=80
SHIP_CONTIGUOUS_OVERNIGHT_BASE_CENTS=2999
SHIP_CONTIGUOUS_OVERNIGHT_PER_LB_CENTS=120
SHIP_AKHI_STANDARD_BASE_CENTS=1499
SHIP_AKHI_STANDARD_PER_LB_CENTS=150
SHIP_AKHI_EXPEDITED_BASE_CENTS=2999
SHIP_AKHI_EXPEDITED_PER_LB_CENTS=200
SHIP_TERRITORY_STANDARD_BASE_CENTS=1899
SHIP_TERRITORY_STANDARD_PER_LB_CENTS=175
SHIP_TERRITORY_EXPEDITED_BASE_CENTS=3499
SHIP_TERRITORY_EXPEDITED_PER_LB_CENTS=225

# Seed super admin. Used only by prisma db seed.
SUPER_ADMIN_EMAIL=admin@afribasket.test
SUPER_ADMIN_PASSWORD=ChangeMeNow!123
SUPER_ADMIN_NAME=AfriBasket Super Admin

# Scheduled jobs. Set to false to run the API without BullMQ workers.
JOBS_ENABLED=true
